    "interface": "#0b7268",
    "interface.defaultLibrary": "#085a52",
    "macro": "#6b3f00",
    "method": "#1a5fb4",
    "method.defaultLibrary": "#124a8c",
    "namespace": "#622a92",
    "parameter": "#24292f",
    "property": "#24292f",
    "struct": "#0b7268",
