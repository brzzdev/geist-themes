  "tokenColors": [
    {
      "scope": [
        "entity.name.function.decorator",
        "entity.name.function.preprocessor",
        "entity.other.attribute-name",
        "keyword.control.directive",
        "meta.decorator",
        "meta.preprocessor",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#6b3f00"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#656a70",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant.language",
        "support.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#8a5300"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#1a5fb4"
      }
    },
    {
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#124a8c"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.operator.alignas",
        "keyword.operator.alignof",
        "keyword.operator.cast",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.operator.logical.python",
        "keyword.operator.new",
        "keyword.operator.noexcept",
        "keyword.operator.sizeof",
        "keyword.operator.type.asserts",
        "keyword.operator.typeid",
        "keyword.operator.wordlike",
        "storage",
        "variable.language"
      ],
      "settings": {
        "foreground": "#7e3ab8"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#124a8c"
      }
    },
    {
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#4f5359"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#622a92"
      }
    },
    {
      "scope": [
        "constant.character",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#8a5300"
      }
    },
    {
      "scope": [
        "markup.bold",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#24292f",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#24292f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "meta.brace",
        "punctuation"
      ],
      "settings": {
        "foreground": "#4f5359"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#a8242b"
      }
    },
    {
      "scope": [
        "punctuation.definition.string",
        "string"
      ],
      "settings": {
        "foreground": "#18703a"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#a8242b"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#0b7268"
      }
    },
    {
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#085a52"
      }
    },
    {
      "scope": [
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#085a52"
      }
    },
    {
      "scope": [
        "meta.definition.variable",
        "support.type.property-name",
        "support.variable",
        "variable"
      ],
      "settings": {
        "foreground": "#24292f"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#0b7268",
    "class.defaultLibrary": "#085a52",
    "decorator": "#6b3f00",
    "enum": "#0b7268",
    "enum.defaultLibrary": "#085a52",
    "enumMember": "#8a5300",
    "function": "#1a5fb4",
    "function.defaultLibrary": "#124a8c",
    "interface": "#0b7268",
    "interface.defaultLibrary": "#085a52",
    "macro": "#6b3f00",
    "method": "#1a5fb4",
    "method.defaultLibrary": "#124a8c",
    "namespace": "#622a92",
    "parameter": "#24292f",
    "property": "#24292f",
    "struct": "#0b7268",
    "struct.defaultLibrary": "#085a52",
    "type": "#0b7268",
    "type.defaultLibrary": "#085a52",
    "typeParameter": "#085a52",
    "variable": "#24292f"
  }
}
