    "terminal.ansiBrightCyan": "#085a52",
    "terminal.ansiBrightGreen": "#0f5a2c",
    "terminal.ansiBrightMagenta": "#622a92",
    "terminal.ansiBrightRed": "#a8242b",
    "terminal.ansiBrightWhite": "#171717",
    "terminal.ansiBrightYellow": "#6b3f00",
    "terminal.ansiCyan": "#0b7268",
    "terminal.ansiGreen": "#18703a",
